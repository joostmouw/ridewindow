<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="Ridewindow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Deep link voor de e-mailbevestiging (2026-09-21, OPEN.md punt 11).
                Supabase stuurt de browser na het bevestigen van het account
                door naar ridewindow://confirm?code=... . Dit filter zorgt dat
                Android dan de app opent in plaats van een dood adres. De SDK
                (SupabaseAuth) vangt de link zelf op via app_links en wisselt
                de code om voor een sessie. De launchMode singleTop hierboven
                is daarvoor nodig: zo komt een warme start binnen via
                onNewIntent in plaats van een tweede MainActivity. Zonder deze
                redirect vallen de auth-mails terug op de Site URL, en dat was
                een localhost-dood adres.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ridewindow"/>
            </intent-filter>
        </activity>
        <!-- WorkManager achtergrondtaak service -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
            Hier stond een receiver `be.tramckrijte.workmanager.RescheduleOnBootReceiver`,
            toegevoegd op 2026-06-03. Die klasse bestaat niet: workmanager heet sinds
            0.6 `dev.fluttercommunity.workmanager` en kent helemaal geen boot-receiver
            meer. Android instantieert een receiver pas als hij vuurt, dus dit bleef
            drie maanden onzichtbaar tot een herstart, en dan crasht het proces met
            ClassNotFoundException voordat er een scherm is. Gevonden op 2026-09-20 in
            de logcat van build 45.

            Er komt niets voor in de plaats: androidx.work herplant zijn eigen werk na
            een herstart via zijn eigen receiver, die het via de plugin zelf meebrengt.
        -->

        <!-- flutter_local_notifications: standaard notificatiekanaal -->
        <meta-data
            android:name="com.dexterous.flutterlocalnotifications.default_notification_channel_id"
            android:value="ride_alerts" />

        <!-- Ridewindow home screen widget -->
        <receiver
            android:name="com.fanalists.ridewindow.ridewindow.RideWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ride_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
            Zonder dit blok ziet de app op Android 11+ geen enkele browser.
            Package visibility verbergt sinds API 30 alles wat niet expliciet
            bevraagd wordt, en `canLaunchUrl` bouwt op precies die bevraging.
            url_launcher_android brengt deze declaratie niet zelf mee (zijn
            manifest bevat alleen een WebViewActivity), dus de app moet het
            doen.

            Wat het kostte: de rij "Privacy Policy" in Profiel stond achter een
            `if (await canLaunchUrl(...))` zonder else. Die gaf false, er
            gebeurde niets, en de tester tikte door naar de rij eronder. Dat is
            de Open-Meteo-link, die geen guard had en dus wel opende, met
            "Free Weather API" bovenaan. Zo werd dit gemeld als "het
            privacybeleid opent een weer-API". Gevonden op 2026-09-21.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
