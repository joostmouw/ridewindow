# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Phase 1 — coverage artifacts
coverage/

# Signing credentials — NEVER commit
*.jks
*.keystore
android/key.properties

# Gradle build output (not rooted at /build/, needs its own entry)
/android/build/

# Phase 12 — dart2js worker build artifacts (sourcemap/deps, not needed at runtime)
web/drift_worker.dart.js.deps
web/drift_worker.dart.js.map

# Firebase CLI local cache/logs — never commit
.firebase/
firebase-debug.log

# Claude Code — machine-local overrides, not shared across machines
.claude/settings.local.json

# Ondertekende juridische documenten -- horen niet in een publieke repo
*DPA*.pdf

# Claude Code assistant-geheugen — hoort in ~/.claude, niet in de repo
.claude/projects/

# Firebase Agent Skills — automatisch geïnstalleerd door `firebase init
# hosting:github` (2026-08-04). Ze staan lokaal op schijf en werken gewoon,
# maar horen niet in de repo: het zijn tooling-bestanden, geen appcode, en
# elf van de twaalf gaan over Firebase-diensten die dit project niet
# gebruikt (Firestore, Crashlytics, Data Connect, App Hosting, Remote
# Config, AI Logic, Xcode). Dit project gebruikt Firebase uitsluitend als
# statische host voor build/web; alle data loopt via Supabase.
.agents/
.claude/skills/firebase-*
.claude/skills/extension-to-functions-codebase
.claude/skills/xcode-project-setup
skills-lock.json

# Bronvideo's voor marketing/animatie — te groot voor een publieke repo,
# niet nodig om de app te bouwen. Bewaar ze buiten git.
photos/*.mp4
